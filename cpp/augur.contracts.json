{
  "version": 1,
  "contractsDir": "contracts",
  "importFrom": "augur/contract_runtime.hpp",
  "contracts": [
    {
      "id": "C-28",
      "criterion": "C-28 liveStatus(version, epochMs): DB 非依存の死活応答にサービス名、稼働版、ok 状態、要求時刻の UTC 表記を含める",
      "symbol": "liveStatus",
      "file": "src/liveness.cpp",
      "module": "contracts/liveness.hpp",
      "mode": "observe",
      "sample": 1
    },
    {
      "id": "C-29",
      "criterion": "C-29 postgresPolicy(): 接続上限 10、取得上限 10 秒、文実行上限 7 秒、TCP keepalive 開始 15 秒を返す",
      "symbol": "postgresPolicy",
      "file": "src/db/postgres_policy.cpp",
      "module": "contracts/postgres_policy.hpp",
      "mode": "observe",
      "sample": 1
    }
  ]
}
