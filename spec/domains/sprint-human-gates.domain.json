    {
      "pathPattern": "(^|/)modules/task/scrum-master/.*\\.ts$"
    },
    {
      "pathPattern": "(^|/)src/db/scrum-master-migration\\.ts$"
    },
    {
      "pathPattern": "(^|/)tests/unit/scrum-master-.*\\.test\\.ts$"
